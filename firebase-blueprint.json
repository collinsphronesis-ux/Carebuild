{
  "entities": {
    "BeneficiaryCase": {
      "title": "BeneficiaryCase",
      "description": "A public sponsorship or zero-interest microloan appeal for an underprivileged, sick, or low-income beneficiary without private PII.",
      "type": "object",
      "properties": {
        "creatorId": { "type": "string", "description": "Firebase Auth UID of the case submitter." },
        "beneficiaryName": { "type": "string", "description": "Display first name or community alias." },
        "region": { "type": "string", "description": "City or region of the beneficiary." },
        "title": { "type": "string", "description": "Concise case headline." },
        "story": { "type": "string", "description": "Narrative explaining the hardship and goal." },
        "allocationPlan": { "type": "string", "description": "Transparent breakdown of how funds are used." },
        "category": { "type": "string", "enum": ["medical", "essentials", "education", "livelihood"] },
        "supportType": { "type": "string", "enum": ["sponsorship", "microloan", "both"] },
        "goalAmountCents": { "type": "integer", "description": "Funding goal in cents." },
        "raisedAmountCents": { "type": "integer", "description": "Total raised so far in cents." },
        "supporterCount": { "type": "integer", "description": "Number of supporters who contributed." },
        "repaymentMonths": { "type": "integer", "description": "Repayment term in months (0 for direct sponsorship)." },
        "urgency": { "type": "string", "enum": ["standard", "urgent"] },
        "status": { "type": "string", "enum": ["active", "funded"] },
        "visibility": { "type": "string", "enum": ["public"] },
        "coverAssetKey": { "type": "string", "enum": ["hero", "medical", "livelihood"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on last update." }
      },
      "required": [
        "creatorId", "beneficiaryName", "region", "title", "story", "allocationPlan",
        "category", "supportType", "goalAmountCents", "raisedAmountCents",
        "supporterCount", "repaymentMonths", "urgency", "status", "visibility",
        "coverAssetKey", "createdAt", "updatedAt"
      ]
    },
    "ImpactUpdate": {
      "title": "ImpactUpdate",
      "description": "A milestone or repayment update authored by the case creator.",
      "type": "object",
      "properties": {
        "caseId": { "type": "string" },
        "authorId": { "type": "string" },
        "headline": { "type": "string" },
        "message": { "type": "string" },
        "milestoneType": { "type": "string", "enum": ["progress", "medical_update", "repayment"] },
        "visibility": { "type": "string", "enum": ["public"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["caseId", "authorId", "headline", "message", "milestoneType", "visibility", "createdAt"]
    },
    "UserPledge": {
      "title": "UserPledge",
      "description": "A supporter's private sponsorship or microloan contribution record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "caseId": { "type": "string" },
        "caseTitle": { "type": "string" },
        "beneficiaryName": { "type": "string" },
        "supportType": { "type": "string", "enum": ["sponsorship", "microloan"] },
        "amountCents": { "type": "integer" },
        "repaidCents": { "type": "integer" },
        "repaymentMonths": { "type": "integer" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "repaid", "fulfilled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId", "caseId", "caseTitle", "beneficiaryName", "supportType",
        "amountCents", "repaidCents", "repaymentMonths", "status", "createdAt", "updatedAt"
      ]
    },
    "OreNote": {
      "title": "OreNote",
      "description": "A saved summary or digest generated by Ore, the user's personal AI steward.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "topic": { "type": "string" },
        "prompt": { "type": "string" },
        "summary": { "type": "string" },
        "scopeType": { "type": "string", "enum": ["portfolio", "case", "discover", "custom"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "topic", "prompt", "summary", "scopeType", "createdAt"]
    }
  },
  "firestore": {
    "/beneficiaryCases/{caseId}": {
      "schema": { "$ref": "#/entities/BeneficiaryCase" },
      "description": "Publicly visible sponsorship and microloan cases."
    },
    "/beneficiaryCases/{caseId}/updates/{updateId}": {
      "schema": { "$ref": "#/entities/ImpactUpdate" },
      "description": "Public milestone updates attached to a beneficiary case."
    },
    "/users/{userId}/pledges/{pledgeId}": {
      "schema": { "$ref": "#/entities/UserPledge" },
      "description": "Private user sponsorship and microloan portfolio entries."
    },
    "/users/{userId}/oreNotes/{noteId}": {
      "schema": { "$ref": "#/entities/OreNote" },
      "description": "User-saved summaries generated by Ore."
    }
  }
}
